# =========================================
# LEO Production Environment Config
# =========================================

NODE_ENV=production
PORT=8198

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/leo_prod

# Data Directory for local workspaces and sandboxes
DATA_DIR=/var/lib/leo/data

# Security / Auth
# Comma-separated list of Admin API keys
API_KEYS=sk-prod-your-secure-key-here

# CORS Origins (comma-separated)
CORS_ORIGINS=https://leo.yourdomain.com

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Providers (Optional - can also be configured via Web UI)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# =========================================
# Escape hatches (security protections OFF)
# =========================================
# Each flag below DISABLES a protection. Leave them unset in production.
# packages/gateway/src/config/escape-hatches.ts is the source of truth and
# every flag it declares must appear here so an operator can discover it.

# Allow private/loopback LLM base URLs (disables the SSRF guard) — Ollama, LM Studio, vLLM
# OWNPILOT_ALLOW_LOCAL_LLM_URL=true

# Allow a private/loopback embedding service base URL (disables its SSRF guard)
# OWNPILOT_ALLOW_LOCAL_EMBEDDING_URL=true

# Run agent code on the host instead of in the Docker sandbox
# OWNPILOT_ALLOW_LOCAL_EXEC=1

# Drop the hardening applied to the code-execution sandbox container
# DOCKER_SANDBOX_RELAXED_SECURITY=true

# Let agent file tools reach the home directory
# ALLOW_HOME_DIR_ACCESS=true

# Let coding agents work in any directory (removes the allowlist)
# OWNPILOT_CODING_AGENT_ANY_DIR=true

# Let skills execute shell scripts
# OWNPILOT_ENABLE_SKILL_SCRIPTS=true

# Let extension tools reach host resources from the sandbox
# OWNPILOT_ENABLE_EXTENSION_HOST_ACCESS=true

# Return internal error details in production API responses
# EXPOSE_INTERNAL_ERRORS=true
